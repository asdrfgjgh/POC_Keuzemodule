{
  "routes": [
    {
      "route": "/*",
      "rewrite": "/.output/server/functions/index",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/.output/server/functions/index",
    "exclude": [
      "/assets/*",
      "/favicon.ico"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/.output/server/functions/index",
      "statusCode": 404
    }
  }
}