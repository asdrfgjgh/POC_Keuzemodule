{
"name": "nuxt-app",
"type": "module",
"private": true,
"engines": {
  "node": ">=20.0.0" 
},
"scripts": {
"build": "nuxt build",
"dev": "nuxt dev",
"generate": "nuxt generate",
"preview": "nuxt preview",
"start": "node .output/server/index.mjs",
"postinstall": "nuxt prepare",
"seed:tags": "ts-node -P ./tsconfig.json -r tsconfig-paths/register ./server/scripts/tagger.ts",
"deploy:frontend": "npm run build && npm run start",
"deploy:backend": "npm run build && npm run start"
},
"dependencies": {
"mongoose": "^8.19.0",
"nuxt": "^4.1.2",
"vue": "^3.5.21",
"vue-router": "^4.5.1"
},
"devDependencies": {
"@types/node": "^24.6.2",
"ts-node": "^10.9.2",
"tsconfig-paths": "^4.2.0",
"typescript": "^5.9.2"
}
}